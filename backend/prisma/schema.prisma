generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stored as a plain string (validated at the API layer via Zod, see src/schemas/lead.ts)
// rather than a native Postgres enum, since the required values ("Proposal Sent",
// "Closed-Won") contain spaces/hyphens that aren't valid Postgres enum identifiers.
model Lead {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  status    String   @default("New")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Attribution only — leads are a shared workspace, not scoped per user.
  // SetNull on delete: removing a user shouldn't cascade-delete the leads they created.
  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@map("leads")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leadsCreated Lead[]

  @@map("users")
}

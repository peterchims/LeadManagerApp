NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lead_manager?schema=public"
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slashes).
CORS_ORIGIN="http://localhost:3000"

LOG_LEVEL=info

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Generate a strong local secret with: openssl rand -base64 48
JWT_SECRET="dev-only-secret-change-me-please-32chars-minimum"
JWT_EXPIRES_IN=7d
